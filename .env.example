# Copy to services/api/.env (git-ignored). Never commit real values.

# Local development
DJANGO_DEBUG=true
# DJANGO_SECRET_KEY=  (required when DJANGO_DEBUG is false)

# Database: SQLite is used if this is unset.
# DATABASE_URL=postgres://archivehub:archivehub@localhost:5432/archivehub

# Assistant: "anthropic" (needs a key) or "fake" (offline echo for development).
ASSISTANT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium
# ASSISTANT_FAKE_DELAY=0.1

# Live interviews (WP5). "whisper" needs: pip install -r requirements-speech.txt
# (models download on first use). "fake" works offline with a scripted transcript.
# SPEECH_PROVIDER=whisper
# SPEECH_MODEL=small.en
# SPEECH_LIVE_MODEL=base.en
# INTERVIEW_MODEL=claude-opus-5-5

# Optional
# SENTRY_DSN=
# ACCOUNT_EMAIL_VERIFICATION=none

# Time map (WP6). Historic OS maps (National Library of Scotland via MapTiler) need a key;
# restrict it to your own sites in MapTiler. Without it only today's map is shown.
# MAPTILER_KEY=
# MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
