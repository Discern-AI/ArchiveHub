   "term": "Board of guardians",
   "also": [
    "guardians",
    "guardians of the poor"
   ],
   "kind": "poor law",
   "meaning": "The body that ran a poor law union, elected by ratepayers from the union's parishes.",
   "sources": [
    {
     "title": "The National Archives research guide: Poverty and the Poor Laws",
     "url": "https://www.nationalarchives.gov.uk/help-with-your-research/research-guides/poverty-poor-laws"
