  {
   "key": "poor-law-union",
   "term": "Poor law union",
   "also": [
    "union",
    "poor law unions"
   ],
   "kind": "poor law",
   "meaning": "From 1834, parishes in England and Wales were grouped into poor law unions to run poor relief together, reporting to the new Poor Law Commission. To find a union's records you usually need to know its name.",
   "sources": [
    {
     "title": "The National Archives research guide: Poverty and the Poor Laws",
     "url": "https://www.nationalarchives.gov.uk/help-with-your-research/research-guides/poverty-poor-laws"
    }
   ],
   "checked_on": "2026-11-07"
  },
